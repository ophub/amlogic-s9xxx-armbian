[Unit]
Description=Expand the Armbian USB root filesystem
After=local-fs.target armbian-resize-filesystem.service
ConditionPathIsReadWrite=/

[Service]
Type=oneshot
ExecCondition=/usr/bin/grep -qx yes /root/.no_rootfs_resize
ExecStart=/usr/libexec/armbian-usb-rootfs-resize
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
