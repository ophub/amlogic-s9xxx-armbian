[Unit]
Description=Armbian front-panel power and Ethernet LEDs
After=network.target ssh.service ssh.socket

[Service]
Type=exec
Environment=POWER_READY=green:power
Environment=POWER_BOOT=red:power
Environment=LINK_UP=green:lan
Environment=LINK_DOWN=red:lan
Environment=INTERFACE=eth0
ExecStart=/usr/libexec/armbian-front-panel
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
