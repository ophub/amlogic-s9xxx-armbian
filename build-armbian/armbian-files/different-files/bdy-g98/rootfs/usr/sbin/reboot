#!/bin/sh

# sync all filesystems: flush dirty pages to disk before reboot
echo s > /proc/sysrq-trigger
# remount all filesystems read-only to prevent further writes during reboot
echo u > /proc/sysrq-trigger
# wait for the kernel to finish sync and remount
sleep 3
# trigger an immediate system reboot via SysRq
echo b > /proc/sysrq-trigger
