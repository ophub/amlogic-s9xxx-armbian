# W103D requirements layered on top of ophub/kernel's stable config-6.18.
# Keep common USB networking and WLAN drivers as modules for the three host ports.
CONFIG_ARCH_MESON=y
CONFIG_MMC_MESON_GX=y
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_MESON=y
CONFIG_MESON_GXL_PHY=y

CONFIG_BT=y
CONFIG_BT_HCIBTSDIO=m
CONFIG_BT_MTKSDIO=m
CONFIG_MT76=m
CONFIG_MT76_SDIO=m
CONFIG_MT7615_COMMON=m
CONFIG_MT7663S=m
CONFIG_MT7663S_W103D_COMBO=y

CONFIG_USB_DWC3=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_USB_NET_DM9601=m
CONFIG_USB_NET_SR9700=m
CONFIG_ATH9K_HTC=m
CONFIG_BRCMFMAC_USB=y
CONFIG_RTL8XXXU=m
CONFIG_RTW88_USB=m
CONFIG_MT76_USB=m

# Qualcomm Shortcut-FE is unrelated to this Amlogic target.
# Keep the out-of-tree accelerator disabled for this validation configuration.
# Disabling the accelerator does not disable any Ethernet or USB NIC driver.
# CONFIG_SHORTCUT_FE is not set
# CONFIG_FAST_CLASSIFIER is not set
# CONFIG_SFE_ECM is not set
# CONFIG_SFE_SUPPORT_IPV6 is not set

# The release suffix is supplied explicitly by the make command.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
